APP_NAME=YokPrinting
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yokprinting
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Configure these explicitly when traffic passes through a reverse proxy.
# TRUSTED_PROXIES=10.0.0.10,10.0.0.11
# TRUSTED_HOSTS=^erp\.example\.com$

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
EXPENSE_PROOF_DISK=expense_proofs
EXPENSE_PROOF_RETENTION_DAYS=365
EXPENSE_PROOF_CLEANUP_RETRY_MINUTES=15
EXPENSE_PROOF_CLEANUP_BATCH_SIZE=100
EXPENSE_PROOF_CLEANUP_CLAIM_TIMEOUT_MINUTES=30
EXPENSE_PROOF_ORPHAN_GRACE_MINUTES=1440
OPERATIONS_HEALTH_MAX_AGE_MINUTES=5
REPORT_TEMPORARY_DIRECTORY=
REPORT_TEMPORARY_FILE_GRACE_MINUTES=60
REPORT_EXPORT_RATE_LIMIT_PER_MINUTE=10
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
